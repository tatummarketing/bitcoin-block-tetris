TATUM_API_KEY=your_tatum_api_key_here
# Optional Bitcoin-specific key; falls back to TATUM_API_KEY when unset.
# TATUM_API_KEY_BTC=your_tatum_bitcoin_key_here

# bitcoin-mainnet (default), bitcoin-testnet, bitcoin-testnet4 or bitcoin-signet
BTC_CHAIN=bitcoin-mainnet

# Comma-separated Origin/Host allowlist for /api/* proxies (required in production)
API_ALLOWED_HOSTS=apps.tatum.io,bitcoin-block-tetris.webflow.io,localhost,127.0.0.1

# Mount path when deployed under apps.tatum.io
# NEXT_PUBLIC_BASE_PATH=/bitcoin-block-tetris

# Best-effort per-IP + per-route rate limits (defaults shown)
# API_RATE_LIMIT=60
# API_RATE_WINDOW_MS=60000
